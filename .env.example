# ====================================================================
# KONFIGURASI DATABASE POSTGRESQL (PILIH SALAH SATU CARA DI BAWAH)
# ====================================================================

# (Menggunakan satu baris URL):
# DATABASE_URL="postgresql://postgres:password_anda@localhost:5432/tumin_db"

# Server Port
PORT=3000

# ====================================================================
# KREDENSIAL INTERNAL TOKO (OWNER & KASIR) - FILE LOKAL .ENV 
# ====================================================================
# Perubahan atau reset kata sandi Owner & Kasir dilakukan langsung di file .env


# Akun Owner (Pemilik Toko)
OWNER_USERNAME="owner@tinounderwear.id"
OWNER_PASSWORD="password_rahasia_owner_disini"

# Akun Kasir 1 (Staf Kasir Utama)
KASIR_USERNAME="kasir"
KASIR_PASSWORD="password_rahasia_kasir_disini"

# Akun Kasir 2 (Staf Kasir Shift Sore / Cadangan)
KASIR2_USERNAME="kasir2"
KASIR2_PASSWORD="password_rahasia_kasir2_disini"


