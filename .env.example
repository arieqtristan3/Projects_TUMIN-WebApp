# Salin ke .env untuk pengembangan lokal. Jangan commit file .env.
NODE_ENV=development
PORT=3000

# PostgreSQL lokal: gunakan DATABASE_URL (direkomendasikan) atau DB_*.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/tumin_db

# Wajib: buat dengan `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_EXPIRES_IN=24h


# Untuk deployment, isi domain publik aplikasi (tanpa trailing slash).
# Jika frontend dan API satu domain, CORS_ORIGIN dapat dikosongkan.
CORS_ORIGIN=http://localhost:3000

# Lokal: false. Deployment: sesuaikan dengan reverse proxy.
TRUST_PROXY=false

# Gunakan true jika koneksi PostgreSQL membutuhkan SSL.
PGSSL=false